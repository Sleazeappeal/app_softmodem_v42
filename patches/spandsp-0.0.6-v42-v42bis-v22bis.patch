+/* Hex dump of a frame (address, control, info; no FCS), for XID interop
+   problems. */
+static void log_frame_hex(v42_state_t *ss, const char *tag, const uint8_t *frame, int len)
+{
+    char hex[3*64 + 1];
+    int i;
+    int n;
+
+    n = (len > 64)  ?  64  :  len;
+    for (i = 0;  i < n;  i++)
+        snprintf(&hex[3*i], 4, "%02x ", frame[i]);
+    hex[3*n] = '\0';
+    span_log(&ss->logging, SPAN_LOG_FLOW, "%s (%d bytes): %s\n", tag, len, hex);
+}
+/*- End of function --------------------------------------------------------*/
+
+/* One trace line per LAPM frame, rx and tx. C/R as in lapm_receive(): a
+   received frame to rsp_addr or a sent frame to cmd_addr is a command. */
+static void log_frame_trace(v42_state_t *ss, int tx, const uint8_t *frame, int len)
+{
+    static const char *s_names[4] = {"RR", "RNR", "REJ", "SREJ"};
+    lapm_state_t *s;
+    const char *dir;
+    const char *cr;
+    const char *u_name;
+
+    s = &ss->lapm;
+    dir = (tx)  ?  "tx"  :  "rx";
+    if (len < 2)
+    {
+        span_log(&ss->logging, SPAN_LOG_FLOW, "%s frame too short (%d bytes)\n", dir, len);
+        return;
+    }
+    cr = (frame[0] == ((tx)  ?  s->cmd_addr  :  s->rsp_addr))  ?  "cmd"  :  "rsp";
+    if ((frame[1] & 0x01) == 0)
+    {
+        span_log(&ss->logging, SPAN_LOG_FLOW, "%s I ns=%d nr=%d p=%d info=%d | vs=%d va=%d vr=%d\n",
+                 dir, frame[1] >> 1, (len > 2)  ?  frame[2] >> 1  :  -1, (len > 2)  ?  frame[2] & 1  :  -1,
+                 len - 3, s->vs, s->va, s->vr);
+        return;
+    }
+    if ((frame[1] & LAPM_FRAMETYPE_MASK) == LAPM_FRAMETYPE_S)
+    {
+        span_log(&ss->logging, SPAN_LOG_FLOW, "%s %s %s nr=%d pf=%d | vs=%d va=%d vr=%d\n",
+                 dir, s_names[(frame[1] & 0x0C) >> 2], cr, (len > 2)  ?  frame[2] >> 1  :  -1,
+                 (len > 2)  ?  frame[2] & 1  :  -1, s->vs, s->va, s->vr);
+        return;
+    }
+    switch (frame[1] & 0xEC)
+    {
+    case LAPM_U_UI:     u_name = "UI";     break;
+    case LAPM_U_DM:     u_name = "DM";     break;
+    case LAPM_U_DISC:   u_name = "DISC";   break;
+    case LAPM_U_UA:     u_name = "UA";     break;
+    case LAPM_U_SABME:  u_name = "SABME";  break;
+    case LAPM_U_FRMR:   u_name = "FRMR";   break;
+    case LAPM_U_XID:    u_name = "XID";    break;
+    case LAPM_U_TEST:   u_name = "TEST";   break;
+    default:            u_name = "U?";     break;
+    }
+    span_log(&ss->logging, SPAN_LOG_FLOW, "%s %s %s pf=%d len=%d\n",
+             dir, u_name, cr, (frame[1] & LAPM_U_PF)  ?  1  :  0, len);
+}
+/*- End of function --------------------------------------------------------*/
