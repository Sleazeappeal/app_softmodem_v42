+/* Check that every group and parameter of an XID lies inside the frame
+   before receive_xid() touches any state. (The stock parser used uint16_t
+   lengths, so its "< 0" overrun checks never fired.) */
+static int xid_well_formed(const uint8_t *frame, int len)
+{
+    int group_id;
+    int group_len;
+    int param_len;
+
+    if (len < 3)
+        return FALSE;
+    frame += 3;
+    len -= 3;
+    while (len > 0)
+    {
+        /* The user data subfield (ISO/IEC 8885) has no group length and runs
+           to the end of the frame. Conexant modems put their V.44 offer
+           there; we do not do V.44, so it is ignored. */
+        if (frame[0] == GI_USER_DATA)
+            return TRUE;
+        if (len < 3)
+            return FALSE;
+        group_id = frame[0];
+        group_len = (frame[1] << 8) | frame[2];
+        frame += 3;
+        len -= 3;
+        if (group_len > len)
+            return FALSE;
+        len -= group_len;
+        if (group_id != GI_PARAM_NEGOTIATION  &&  group_id != GI_PRIVATE_NEGOTIATION)
+        {
+            /* Not parsed by receive_xid(), only skipped */
+            frame += group_len;
+            continue;
+        }
+        while (group_len > 0)
+        {
+            if (group_len < 2)
+                return FALSE;
+            param_len = frame[1];
+            frame += 2;
+            group_len -= 2;
+            if (param_len > group_len)
+                return FALSE;
+            frame += param_len;
+            group_len -= param_len;
+        }
+    }
+    return TRUE;
+}
+/*- End of function --------------------------------------------------------*/
