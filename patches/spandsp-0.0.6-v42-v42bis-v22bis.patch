+/* Keeps our own V.42bis request inside what v42bis_init() accepts. The
+   negotiated values are the smaller of this and the (range checked) peer
+   offer, so they stay inside too. */
+static void clamp_v42bis_config(v42_config_parameters_t *config)
+{
+    if (config->comp_dict_size < V42BIS_MIN_DICTIONARY_SIZE)
+        config->comp_dict_size = V42BIS_MIN_DICTIONARY_SIZE;
+    else if (config->comp_dict_size > V42BIS_MAX_CODEWORDS)
+        config->comp_dict_size = V42BIS_MAX_CODEWORDS;
+    if (config->comp_max_string < V42BIS_MIN_STRING_SIZE)
+        config->comp_max_string = V42BIS_MIN_STRING_SIZE;
+    else if (config->comp_max_string > V42BIS_MAX_STRING_SIZE)
+        config->comp_max_string = V42BIS_MAX_STRING_SIZE;
+}
+/*- End of function --------------------------------------------------------*/
+
+/* Stores the V.42bis parameters receive_xid() parsed (stock spandsp left
+   this call commented out and dropped them). V.42bis 5.1: a direction is
+   compressed only if both sides asked for it, and P1/P2 are the smaller of
+   the two offers. receive_xid() has checked the peer's values. */
+static void v42_update_config(v42_state_t *ss, const v42_config_parameters_t *config)
+{
+    ss->config.comp &= config->comp;
+    if (config->comp_dict_size < ss->config.comp_dict_size)
+        ss->config.comp_dict_size = config->comp_dict_size;
+    if (config->comp_max_string < ss->config.comp_max_string)
+        ss->config.comp_max_string = config->comp_max_string;
+    ss->v42bis_negotiated = TRUE;
+}
+/*- End of function --------------------------------------------------------*/
