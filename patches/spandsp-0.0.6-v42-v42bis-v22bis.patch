+/* What our XIDs request. Call after v42_init(), before v42_restart(). Does
+   not set v42bis_negotiated: only the peer's XID does that. */
+SPAN_DECLARE(void) v42_set_local_v42bis_request(v42_state_t *s, int comp, int comp_dict_size, int comp_max_string)
+{
+    s->config.comp = comp;
+    s->config.comp_dict_size = comp_dict_size;
+    s->config.comp_max_string = comp_max_string;
+    clamp_v42bis_config(&s->config);
+}
+/*- End of function --------------------------------------------------------*/
+
+/* The negotiated V.42bis parameters. FALSE (out parameters untouched) until
+   an XID from the peer has set them. */
+SPAN_DECLARE(int) v42_get_negotiated_v42bis(v42_state_t *s, int *comp, int *comp_dict_size, int *comp_max_string)
+{
+    if (!s->v42bis_negotiated)
+        return FALSE;
+    if (comp)
+        *comp = s->config.comp;
+    if (comp_dict_size)
+        *comp_dict_size = s->config.comp_dict_size;
+    if (comp_max_string)
+        *comp_max_string = s->config.comp_max_string;
+    return TRUE;
+}
+/*- End of function --------------------------------------------------------*/
